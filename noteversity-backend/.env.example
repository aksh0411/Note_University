# ================= NOTEVERSITY BACKEND — ENVIRONMENT =================
# Copy to .env for local development. NEVER put real secrets in this file
# or in frontend code. In production (Vercel) set these in the Vercel
# dashboard under Settings -> Environment Variables instead.

# ---- Server ----
PORT=5000

# ---- Database (REQUIRED in production) ----
# Local dev works without a database (embedded in-memory fallback).
# Production must point at MongoDB Atlas, e.g.:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/noteversity
MONGO_URI=mongodb://127.0.0.1:27017/noteversity

# ---- Auth secrets (REQUIRED in production) ----
# Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Admin password as a bcrypt hash. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_ADMIN_PASSWORD',10))"
ADMIN_PASSWORD_HASH=$2a$10$replaceWithYourOwnBcryptHash

# ---- Guest identity ----
# Email domain used for anonymous guest accounts
ALLOWED_EMAIL_DOMAIN=paruluniversity.ac.in

# ---- AI providers (server-side only, never exposed to the browser) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
# Optional backup provider
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest
